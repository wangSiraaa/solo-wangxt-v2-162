# ecstore 运行配置（复制为 .env 后按需修改；脚本默认值已可直接演示）
EC_LISTEN=:8080
EC_DATABASE_URL=postgres://ecuser@127.0.0.1:5432/ecstore?sslmode=disable
EC_NODES_ROOT=./nodes

# 纠删码拓扑：4 个数据分片 + 2 个校验分片 => 容忍任意 2 个分片失效
EC_DATA_SHARDS=4
EC_PARITY_SHARDS=2
EC_BLOCK_SIZE=65536

# 集成测试管理库（每个用例自动建/删独立数据库）
EC_TEST_DATABASE_URL=postgres://ecuser@127.0.0.1:5432/postgres?sslmode=disable
